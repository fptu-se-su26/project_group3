<Window x:Class="StudentManagement.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudentManagement.WPF"
        xmlns:views="clr-namespace:StudentManagement.WPF.Views"
        mc:Ignorable="d"
        Title="Student Management System" Height="650" Width="1100" WindowStartupLocation="CenterScreen" Background="{StaticResource ParchmentBrush}">
    <Window.Resources>
        <Style x:Key="SidebarMenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26456E"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource NavyBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,25,20,20">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="28" Height="28" Margin="0,0,8,0">
                            <Path Data="{StaticResource GraduationCapGeometry}" Fill="White" Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock Text="SMS Academy" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource HeadingFont}" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Height="2" Background="{StaticResource GoldBrush}" Margin="0,10,0,10" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="{Binding CurrentUserDisplay}" FontSize="12" Foreground="#D8DEE9" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="10,0,10,20">
                    <Button Content="Change Password" Command="{Binding ChangePasswordCommand}" Height="38" Margin="0,0,0,8"
                            Background="{StaticResource NavyDarkBrush}" Foreground="White" BorderThickness="0"/>
                    <Button Content="Logout" Command="{Binding LogoutCommand}" Height="38"
                            Background="{StaticResource MaroonBrush}" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding MenuItems}" Margin="0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Title}" Command="{Binding Command}" Height="42" Style="{StaticResource SidebarMenuButton}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <views:DashboardView Grid.Column="1" DataContext="{Binding Dashboard}"/>
    </Grid>
</Window>
