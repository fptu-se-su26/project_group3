<Window x:Class="StudentManagement.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudentManagement.WPF"
        xmlns:views="clr-namespace:StudentManagement.WPF.Views"
        mc:Ignorable="d"
        Title="Student Management System" Height="700" Width="1200" WindowStartupLocation="CenterScreen" Background="{StaticResource ParchmentBrush}">
    <Window.Resources>
        <Style x:Key="SidebarMenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                BorderThickness="3,0,0,0" BorderBrush="Transparent"
                                CornerRadius="0,8,8,0" Margin="0,2,12,2">
                            <ContentPresenter VerticalAlignment="Center" 
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== SIDEBAR ===== -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0F172A" Offset="0"/>
                    <GradientStop Color="#1E293B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <!-- Logo / Brand -->
                <StackPanel DockPanel.Dock="Top" Margin="24,28,24,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="10" Margin="0,0,12,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3B82F6" Offset="0"/>
                                    <GradientStop Color="#6366F1" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Viewbox Width="20" Height="20" Margin="0">
                                <Path Data="{StaticResource GraduationCapGeometry}" Fill="White" Stretch="Uniform"/>
                            </Viewbox>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SMS Academy" FontSize="18" FontWeight="Bold" FontFamily="{StaticResource HeadingFont}" Foreground="White"/>
                            <TextBlock Text="Management System" FontSize="10" Foreground="#64748B" Margin="0,-1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Height="1" Background="#334155" Margin="0,18,0,12"/>
                    <!-- User info -->
                    <Border Background="#1E293B" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="16" Background="#3B82F6" Margin="0,0,10,0">
                                <TextBlock Text="👤" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding CurrentUserDisplay}" FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="140"/>
                        </StackPanel>
                    </Border>
                    <Border Height="1" Background="#334155" Margin="0,4,0,8"/>
                </StackPanel>

                <!-- Bottom Buttons -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,24">
                    <Border Height="1" Background="#334155" Margin="0,0,0,16"/>
                    <Button Content="🔑  Change Password" Command="{Binding ChangePasswordCommand}" Height="40" Margin="0,0,0,8"
                            Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" FontSize="13"/>
                    <Button Content="🚪  Logout" Command="{Binding LogoutCommand}" Height="40"
                            Background="#7F1D1D" Foreground="#FCA5A5" BorderThickness="0" FontWeight="SemiBold" FontSize="13"/>
                </StackPanel>

                <!-- Menu Items -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <ItemsControl ItemsSource="{Binding MenuItems}" Margin="0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Title}" Command="{Binding Command}" Height="44" Style="{StaticResource SidebarMenuButton}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== MAIN CONTENT ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar with Back Button -->
            <Border Grid.Row="0" Margin="24,16,24,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNotDashboard}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Button Content="← Back to Dashboard" Command="{Binding GoToDashboardCommand}" 
                        Background="#3B82F6" Foreground="White" Padding="18,10" BorderThickness="0" FontWeight="SemiBold" HorizontalAlignment="Left"/>
            </Border>

            <!-- Main Content Area -->
            <AdornerDecorator Grid.Row="1">
                <ContentControl Content="{Binding CurrentView}" Margin="0"/>
            </AdornerDecorator>
        </Grid>
    </Grid>
</Window>
