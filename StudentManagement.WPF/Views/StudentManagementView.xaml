<Window x:Class="StudentManagement.WPF.Views.StudentManagementView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Management" Height="600" Width="900" Background="#F3F4F6">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Student Management" FontSize="24" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,20"/>
        
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBox Width="250" Height="35" Padding="10,0" VerticalContentAlignment="Center"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,10,0" ToolTip="Search by ID or Name"/>
            <Button Content="Search" Command="{Binding SearchCommand}" Width="80" Height="35" Margin="0,0,20,0"
                    Background="#3B82F6" Foreground="White" FontWeight="SemiBold"/>
            
            <Button Content="Add Student" Command="{Binding AddCommand}" Width="100" Height="35" Margin="0,0,10,0"
                    Background="#10B981" Foreground="White" FontWeight="SemiBold"/>
            <Button Content="Edit Student" Command="{Binding EditCommand}" Width="100" Height="35" Margin="0,0,30,0"
                    Background="#F59E0B" Foreground="White" FontWeight="SemiBold"/>

            <Button Content="Export JSON" Command="{Binding ExportJsonCommand}" Width="90" Height="35" Margin="0,0,10,0"
                    Background="#6366F1" Foreground="White"/>
            <Button Content="Export XML" Command="{Binding ExportXmlCommand}" Width="90" Height="35" Margin="0,0,10,0"
                    Background="#8B5CF6" Foreground="White"/>
            <Button Content="Import JSON" Command="{Binding ImportJsonCommand}" Width="90" Height="35"
                    Background="#4F46E5" Foreground="White"/>
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}"
                  AutoGenerateColumns="False" IsReadOnly="True" Background="White" RowHeight="35"
                  AlternatingRowBackground="#F9FAFB" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Student ID" Binding="{Binding StudentId}" Width="100"/>
                <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Class" Binding="{Binding ClassId}" Width="100"/>
                <DataGridTextColumn Header="Major" Binding="{Binding Class.Major.MajorName}" Width="150"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
