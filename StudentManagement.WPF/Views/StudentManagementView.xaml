<UserControl x:Class="StudentManagement.WPF.Views.StudentManagementView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Height="600" Width="900" Background="{StaticResource ParchmentBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Student Management" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,20"/>
        
        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBox Width="180" Height="35" Padding="10,0" VerticalContentAlignment="Center"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,10,10" ToolTip="Search by ID or Name"/>
            <ComboBox ItemsSource="{Binding Classes}" DisplayMemberPath="ClassName" SelectedItem="{Binding SelectedClassFilter}" Width="120" Height="35" Margin="0,0,10,10" ToolTip="Filter by Class"/>
            <ComboBox ItemsSource="{Binding Majors}" DisplayMemberPath="MajorName" SelectedItem="{Binding SelectedMajorFilter}" Width="120" Height="35" Margin="0,0,10,10" ToolTip="Filter by Major"/>
            <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatusFilter}" Width="120" Height="35" Margin="0,0,10,10" ToolTip="Filter by Status"/>
            <Button Content="Search" Command="{Binding SearchCommand}" Width="80" Height="35" Margin="0,0,20,10"
                    Background="#3B82F6" Foreground="White" FontWeight="SemiBold"/>
            
            <Button Content="Add Student" Command="{Binding AddCommand}" Width="100" Height="35" Margin="0,0,10,10"
                    Background="#10B981" Foreground="White" FontWeight="SemiBold"/>
            <Button Content="Edit Student" Command="{Binding EditCommand}" Width="100" Height="35" Margin="0,0,30,10"
                    Background="#F59E0B" Foreground="White" FontWeight="SemiBold"/>

            <Button Content="Export JSON" Command="{Binding ExportJsonCommand}" Width="90" Height="35" Margin="0,0,10,10"
                    Background="#6366F1" Foreground="White"/>
            <Button Content="Export XML" Command="{Binding ExportXmlCommand}" Width="90" Height="35" Margin="0,0,10,10"
                    Background="#8B5CF6" Foreground="White"/>
            <Button Content="Import JSON" Command="{Binding ImportJsonCommand}" Width="90" Height="35" Margin="0,0,10,10"
                    Background="#4F46E5" Foreground="White"/>
        </WrapPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}"
                  AutoGenerateColumns="False" IsReadOnly="True" Background="White" RowHeight="35"
                  AlternatingRowBackground="#F9FAFB" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Student ID" Binding="{Binding StudentId}" Width="100"/>
                <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Class" Binding="{Binding ClassId}" Width="100"/>
                <DataGridTextColumn Header="Major" Binding="{Binding Class.Major.MajorName}" SortMemberPath="Class.Major.MajorName" Width="150"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

