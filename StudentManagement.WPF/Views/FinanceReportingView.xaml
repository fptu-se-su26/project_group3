<Window x:Class="StudentManagement.WPF.Views.FinanceReportingView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Finance &amp; Reporting" Height="700" Width="1100" Background="#F3F4F6">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Finance &amp; Reporting Dashboard" FontSize="26" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,20"/>
        
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Panel: Tuition List -->
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Button Content="Refresh" Command="{Binding LoadDataCommand}" Width="80" Height="35" Margin="0,0,10,0"/>
                        <Button Content="Generate Tuitions (SP24)" Command="{Binding GenerateTuitionCommand}" Width="180" Height="35" Margin="0,0,10,0" Background="#3B82F6" Foreground="White"/>
                        <Button Content="Process Payment (Cash)" Command="{Binding ProcessPaymentCommand}" Width="180" Height="35" Background="#10B981" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Tuitions}" SelectedItem="{Binding SelectedTuition}"
                              AutoGenerateColumns="False" IsReadOnly="True" RowHeight="35" AlternatingRowBackground="#F9FAFB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Student ID" Binding="{Binding StudentId}" Width="100"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Student.FullName}" Width="150"/>
                            <DataGridTextColumn Header="Credits" Binding="{Binding TotalCredits}" Width="60"/>
                            <DataGridTextColumn Header="Total Amount" Binding="{Binding Amount, StringFormat={}{0:N0}}" Width="120"/>
                            <DataGridTextColumn Header="Paid Amount" Binding="{Binding PaidAmount, StringFormat={}{0:N0}}" Width="120"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Right Panel: Report Summary -->
            <Border Grid.Column="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="20" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Financial Summary" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20" Foreground="#374151"/>
                    
                    <Border Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Total Revenue Collected" FontSize="14" Foreground="#065F46" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding TotalRevenue, StringFormat={}{0:N0} VND}" FontSize="24" FontWeight="Bold" Foreground="#059669"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Background="#FEF2F2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Total Unpaid Amount" FontSize="14" Foreground="#991B1B" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding TotalUnpaid, StringFormat={}{0:N0} VND}" FontSize="24" FontWeight="Bold" Foreground="#DC2626"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
