<Window x:Class="StudentManagement.WPF.Views.AcademicManagementView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Academic Management" Height="650" Width="1000" Background="#F3F4F6">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Academic Management" FontSize="26" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,15"/>

        <TabControl Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="10">
            <!-- Majors Tab -->
            <TabItem Header="Majors" FontSize="16">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Refresh" Command="{Binding LoadDataCommand}" Width="80" Height="30" Margin="0,0,10,0"/>
                        <Button Content="Add Major" Width="90" Height="30" Background="#10B981" Foreground="White"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Majors}" SelectedItem="{Binding SelectedMajor}"
                              AutoGenerateColumns="False" IsReadOnly="True" RowHeight="35" AlternatingRowBackground="#F9FAFB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding MajorId}" Width="100"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding MajorName}" Width="200"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Is Active" Binding="{Binding IsActive}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Classes Tab -->
            <TabItem Header="Classes" FontSize="16">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Refresh" Command="{Binding LoadDataCommand}" Width="80" Height="30" Margin="0,0,10,0"/>
                        <Button Content="Add Class" Width="90" Height="30" Background="#10B981" Foreground="White" Margin="0,0,10,0"/>
                        <Button Content="View Students" Command="{Binding ViewClassStudentsCommand}" Width="110" Height="30" Background="#3B82F6" Foreground="White"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}"
                              AutoGenerateColumns="False" IsReadOnly="True" RowHeight="35" AlternatingRowBackground="#F9FAFB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Class ID" Binding="{Binding ClassId}" Width="100"/>
                            <DataGridTextColumn Header="Major" Binding="{Binding Major.MajorName}" Width="200"/>
                            <DataGridTextColumn Header="Homeroom Lecturer" Binding="{Binding HomeroomLecturer.FullName}" Width="200"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Lecturers Tab -->
            <TabItem Header="Lecturers" FontSize="16">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Refresh" Command="{Binding LoadDataCommand}" Width="80" Height="30" Margin="0,0,10,0"/>
                        <Button Content="Add Lecturer" Width="100" Height="30" Background="#10B981" Foreground="White"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Lecturers}" SelectedItem="{Binding SelectedLecturer}"
                              AutoGenerateColumns="False" IsReadOnly="True" RowHeight="35" AlternatingRowBackground="#F9FAFB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Lecturer ID" Binding="{Binding LecturerId}" Width="120"/>
                            <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="200"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
