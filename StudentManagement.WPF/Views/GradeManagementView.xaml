<Window x:Class="StudentManagement.WPF.Views.GradeManagementView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Grade Management" Height="600" Width="1000" Background="{StaticResource ParchmentBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <TextBlock Text="Grade Management (Lecturer)" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,15"/>
        
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <ComboBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedCourseSection}" DisplayMemberPath="SectionId" Width="180" Height="35" Margin="0,0,10,0"/>
            <Button Content="Refresh List" Command="{Binding LoadDataCommand}" Width="100" Height="35" Margin="0,0,10,0"/>
            <Button Content="Save Selected Grade" Command="{Binding SaveGradeCommand}" Width="150" Height="35" Background="#10B981" Foreground="White" FontWeight="Bold"/>
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Grades}" SelectedItem="{Binding SelectedGrade}"
                  AutoGenerateColumns="False" CanUserAddRows="False" Background="White" RowHeight="35" AlternatingRowBackground="#F9FAFB">
            <DataGrid.Columns>

                <DataGridTextColumn Header="Student ID" Binding="{Binding Registration.StudentId}" SortMemberPath="Registration.StudentId" IsReadOnly="True" Width="100"/>
                <DataGridTextColumn Header="Student Name" Binding="{Binding Registration.Student.FullName}" SortMemberPath="Registration.Student.FullName" IsReadOnly="True" Width="200"/>
                <DataGridTextColumn Header="Assignment (20%)" Binding="{Binding Assignment}" Width="120"/>
                <DataGridTextColumn Header="Progress Test (20%)" Binding="{Binding ProgressTest}" Width="130"/>
                <DataGridTextColumn Header="Practical (20%)" Binding="{Binding Practical}" Width="120"/>
                <DataGridTextColumn Header="Final Exam (40%)" Binding="{Binding FinalExam}" Width="120"/>
                <DataGridTextColumn Header="Final Grade" Binding="{Binding FinalGrade}" IsReadOnly="True" Width="100"/>
                <DataGridTextColumn Header="Result" Binding="{Binding Result}" IsReadOnly="True" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
