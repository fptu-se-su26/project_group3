<Window x:Class="StudentManagement.WPF.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Password" Height="350" Width="380" Background="#F5F7FA"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="25" VerticalAlignment="Center">
        <TextBlock Text="Change Password" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <TextBlock Text="Current Password" Margin="0,0,0,5"/>
        <PasswordBox x:Name="txtCurrent" Height="32" Margin="0,0,0,15" PasswordChanged="txtCurrent_PasswordChanged"/>

        <TextBlock Text="New Password" Margin="0,0,0,5"/>
        <PasswordBox x:Name="txtNew" Height="32" Margin="0,0,0,15" PasswordChanged="txtNew_PasswordChanged"/>

        <TextBlock Text="Confirm New Password" Margin="0,0,0,5"/>
        <PasswordBox x:Name="txtConfirm" Height="32" Margin="0,0,20,0" PasswordChanged="txtConfirm_PasswordChanged"/>

        <Button Content="Save" Command="{Binding SaveCommand}" Height="38" Background="#3B82F6" Foreground="White" FontWeight="SemiBold" Margin="0,20,0,0"/>
    </StackPanel>
</Window>
