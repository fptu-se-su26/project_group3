<Window x:Class="StudentManagement.WPF.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Password" Height="380" Width="400" Background="#F8FAFC"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Border Background="White" CornerRadius="12" Padding="28" BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="15" ShadowDepth="3"/>
            </Border.Effect>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="🔑 Change Password" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,24" Foreground="#0F172A"/>

                <TextBlock Text="Current Password" FontSize="12" Foreground="#64748B" FontWeight="Medium" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtCurrent" Height="38" Margin="0,0,0,16" PasswordChanged="txtCurrent_PasswordChanged"/>

                <TextBlock Text="New Password" FontSize="12" Foreground="#64748B" FontWeight="Medium" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtNew" Height="38" Margin="0,0,0,16" PasswordChanged="txtNew_PasswordChanged"/>

                <TextBlock Text="Confirm New Password" FontSize="12" Foreground="#64748B" FontWeight="Medium" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtConfirm" Height="38" Margin="0,0,0,8" PasswordChanged="txtConfirm_PasswordChanged"/>

                <Button Content="Save Password" Command="{Binding SaveCommand}" Height="42" Background="#3B82F6" Foreground="White" FontWeight="SemiBold" Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
