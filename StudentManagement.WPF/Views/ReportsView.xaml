<Window x:Class="StudentManagement.WPF.Views.ReportsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reports" Height="650" Width="1100" Background="{StaticResource ParchmentBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Academic &amp; Tuition Reports" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,15"/>

        <TabControl Grid.Row="1">
            <TabItem Header="Reports">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,15">
                        <ComboBox ItemsSource="{Binding ReportTypes}" SelectedItem="{Binding SelectedReportType}" Width="200" Height="32" Margin="0,0,10,0"/>
                        <TextBox Width="150" Height="32" Padding="8,0" VerticalContentAlignment="Center" Text="{Binding SemesterFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" ToolTip="Semester filter (optional, for Result/Failure report)"/>
                        <Button Content="Run Report" Command="{Binding RunReportCommand}" Width="110" Height="32" Margin="0,0,10,0" Background="#3B82F6" Foreground="White" FontWeight="SemiBold"/>
                        <Button Content="Export JSON" Command="{Binding ExportCommand}" Width="110" Height="32" Background="#6366F1" Foreground="White"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding ReportData}" AutoGenerateColumns="True" IsReadOnly="True"
                              Background="White" RowHeight="32" AlternatingRowBackground="#F9FAFB"/>
                </Grid>
            </TabItem>
            <TabItem Header="Academic Results (per student)">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,15">
                        <TextBox Width="150" Height="32" Padding="8,0" VerticalContentAlignment="Center" Text="{Binding ResultStudentId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" ToolTip="Student ID"/>
                        <TextBox Width="150" Height="32" Padding="8,0" VerticalContentAlignment="Center" Text="{Binding ResultSemesterId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" ToolTip="Semester ID"/>
                        <Button Content="View Results" Command="{Binding ViewResultsCommand}" Width="120" Height="32" Background="#10B981" Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="20" DataContext="{Binding AcademicResult}">
                        <StackPanel>
                            <TextBlock Text="{Binding StudentId, StringFormat='Student: {0}'}" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding CompletedCredits, StringFormat='Completed Credits: {0}'}" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding AverageScore, StringFormat='Average Score: {0}'}" Margin="0,0,0,15"/>
                            <TextBlock Text="Passed Subjects:" FontWeight="SemiBold"/>
                            <ItemsControl ItemsSource="{Binding PassedSubjects}" Margin="10,0,0,10"/>
                            <TextBlock Text="Failed Subjects:" FontWeight="SemiBold"/>
                            <ItemsControl ItemsSource="{Binding FailedSubjects}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
