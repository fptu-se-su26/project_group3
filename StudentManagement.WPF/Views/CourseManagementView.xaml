<Window x:Class="StudentManagement.WPF.Views.CourseManagementView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Course Management" Height="650" Width="1000" Background="#F3F4F6">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Course Management" FontSize="26" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,15"/>

        <TabControl Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="10">
            <!-- Subjects Tab -->
            <TabItem Header="Subjects" FontSize="16">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Refresh" Command="{Binding LoadDataCommand}" Width="80" Height="30" Margin="0,0,10,0"/>
                        <Button Content="Add Subject" Width="100" Height="30" Background="#10B981" Foreground="White"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject}"
                              AutoGenerateColumns="False" IsReadOnly="True" RowHeight="35" AlternatingRowBackground="#F9FAFB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Subject ID" Binding="{Binding SubjectId}" Width="120"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding SubjectName}" Width="250"/>
                            <DataGridTextColumn Header="Credits" Binding="{Binding Credits}" Width="80"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Course Sections Tab -->
            <TabItem Header="Course Sections" FontSize="16">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Refresh" Command="{Binding LoadDataCommand}" Width="80" Height="30" Margin="0,0,10,0"/>
                        <Button Content="Add Section" Width="100" Height="30" Background="#10B981" Foreground="White" Margin="0,0,10,0"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"
                              AutoGenerateColumns="False" IsReadOnly="True" RowHeight="35" AlternatingRowBackground="#F9FAFB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Section ID" Binding="{Binding SectionId}" Width="100"/>
                            <DataGridTextColumn Header="Subject" Binding="{Binding Subject.SubjectName}" Width="200"/>
                            <DataGridTextColumn Header="Lecturer" Binding="{Binding Lecturer.FullName}" Width="150"/>
                            <DataGridTextColumn Header="Room" Binding="{Binding Room}" Width="80"/>
                            <DataGridTextColumn Header="Day" Binding="{Binding DayOfWeek}" Width="80"/>
                            <DataGridTextColumn Header="Time" Binding="{Binding StartTime}" Width="150"/>
                            <DataGridTextColumn Header="Capacity" Binding="{Binding Capacity}" Width="80"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
