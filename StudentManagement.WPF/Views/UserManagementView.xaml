<Window x:Class="StudentManagement.WPF.Views.UserManagementView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User &amp; Role Management" Height="650" Width="1000" Background="{StaticResource ParchmentBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="User &amp; Role Management" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox Width="200" Height="32" Padding="8,0" VerticalContentAlignment="Center"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
            <Button Content="Search" Command="{Binding SearchCommand}" Width="80" Height="32" Margin="0,0,20,0"/>
            <Button Content="Lock" Command="{Binding LockCommand}" Width="80" Height="32" Margin="0,0,10,0" Background="#EF4444" Foreground="White"/>
            <Button Content="Unlock" Command="{Binding UnlockCommand}" Width="80" Height="32" Margin="0,0,10,0" Background="#10B981" Foreground="White"/>
            <ComboBox ItemsSource="{Binding Roles}" DisplayMemberPath="RoleName" SelectedItem="{Binding SelectedRoleForAssignment}" Width="150" Height="32" Margin="0,0,10,0"/>
            <Button Content="Assign Role" Command="{Binding AssignRoleCommand}" Width="100" Height="32" Background="#3B82F6" Foreground="White"/>
        </StackPanel>

        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="New account:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                <TextBox Width="140" Height="32" Padding="8,0" VerticalContentAlignment="Center" Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" ToolTip="Username"/>
                <PasswordBox x:Name="txtNewPassword" Width="140" Height="32" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,10,0" PasswordChanged="txtNewPassword_PasswordChanged" ToolTip="Password"/>
                <ComboBox ItemsSource="{Binding Roles}" DisplayMemberPath="RoleName" SelectedItem="{Binding SelectedRoleForCreate}" Width="150" Height="32" Margin="0,0,10,0"/>
                <Button Content="Create Account" Command="{Binding CreateUserCommand}" Width="120" Height="32" Background="#10B981" Foreground="White" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                  AutoGenerateColumns="False" IsReadOnly="True" Background="White" RowHeight="35" AlternatingRowBackground="#F9FAFB">
            <DataGrid.Columns>
                <DataGridTextColumn Header="User ID" Binding="{Binding UserId}" Width="70"/>
                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="150"/>
                <DataGridTextColumn Header="Role" Binding="{Binding Role.RoleName}" SortMemberPath="Role.RoleName" Width="150"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
