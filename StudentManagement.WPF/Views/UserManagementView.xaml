<UserControl x:Class="StudentManagement.WPF.Views.UserManagementView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Height="650" Width="1000" Background="{StaticResource ParchmentBrush}">
    <Grid Margin="28,20,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="User &amp; Role Management" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Manage accounts, roles and access permissions" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Action Bar -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.03" BlurRadius="8" ShadowDepth="1"/>
            </Border.Effect>
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox Width="200" Height="34" Padding="8,0" VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" ToolTip="Search by Username"/>
                <Button Content="Search" Command="{Binding SearchCommand}" Width="80" Height="34" Margin="0,0,20,0"
                        Background="#3B82F6" Foreground="White"/>
                <Button Content="Lock" Command="{Binding LockCommand}" Width="80" Height="34" Margin="0,0,8,0" Background="#EF4444" Foreground="White"/>
                <Button Content="Unlock" Command="{Binding UnlockCommand}" Width="80" Height="34" Margin="0,0,16,0" Background="#10B981" Foreground="White"/>
                <ComboBox ItemsSource="{Binding Roles}" DisplayMemberPath="RoleName" SelectedItem="{Binding SelectedRoleForAssignment}" Width="150" Height="34" Margin="0,0,10,0" ToolTip="Select Role to Assign"/>
                <Button Content="Assign Role" Command="{Binding AssignRoleCommand}" Width="100" Height="34" Background="#8B5CF6" Foreground="White"/>
            </WrapPanel>
        </Border>

        <!-- Create Account Card -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="16,14" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.03" BlurRadius="8" ShadowDepth="1"/>
            </Border.Effect>
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="➕ New account:" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" FontSize="13" Foreground="#334155"/>
                <TextBox Width="140" Height="34" Padding="8,0" VerticalContentAlignment="Center" Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" ToolTip="Username / ID"/>
                <PasswordBox x:Name="txtNewPassword" Width="140" Height="34" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,10,0" PasswordChanged="txtNewPassword_PasswordChanged" ToolTip="Password"/>
                <ComboBox ItemsSource="{Binding Roles}" DisplayMemberPath="RoleName" SelectedItem="{Binding SelectedRoleForCreate}" Width="150" Height="34" Margin="0,0,10,0" ToolTip="Role"/>
                <Button Content="Create Account" Command="{Binding CreateUserCommand}" Width="125" Height="34" Background="#10B981" Foreground="White" FontWeight="SemiBold"/>
            </WrapPanel>
        </Border>

        <!-- DataGrid Card -->
        <Border Grid.Row="3" Background="White" CornerRadius="10" Padding="2" BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.03" BlurRadius="8" ShadowDepth="1"/>
            </Border.Effect>
            <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                      AutoGenerateColumns="False" IsReadOnly="True" Background="White" RowHeight="38" AlternatingRowBackground="#F8FAFC"
                      GridLinesVisibility="None" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="User ID" Binding="{Binding UserId}" Width="70"/>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="150"/>
                    <DataGridTextColumn Header="Role" Binding="{Binding Role.RoleName}" SortMemberPath="Role.RoleName" Width="150"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
